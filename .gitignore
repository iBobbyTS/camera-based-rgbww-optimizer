# Versioned project records and small, non-raw evidence are intentionally
# trackable. Keep experimental payloads, firmware artifacts, build output and
# other large generated files out of Git; plans, reports, logs, configs and
# source remain available for post-GUIDE review.
**/*.CR3
**/*.cr3
**/*.RAW
**/*.raw
**/*.NEF
**/*.ARW
**/*.DNG
**/*.npy
**/*.TIF
**/*.tif
**/*.TIFF
**/*.tiff

# Experiment payloads under tmp stay local. Markdown reports, logs, manifests,
# hashes, quality summaries and analysis documents remain trackable.
tmp/**/*.jpg
tmp/**/*.jpeg
tmp/**/*.png
tmp/**/*.rawpy-linear-camera-rgb16.json
tmp/**/location-picker-preview.json
tmp/**/white-endpoints.json
**/white-lut-calibration.json

**/*.bin
**/*.elf
**/*.hex
**/*.uf2
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.7z
